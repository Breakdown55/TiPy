class Vector2:
    def __init__(self, int x=0, int y=0):
        self.x = x
        self.y = y

    def move_ip(self, int dx, int dy):
        self.x += dx
        self.y += dy

    def scale_ip(self, int amount):
        self.x *= amount
        self.y *= amount

    def length_squared(self) -> int:
        return self.x * self.x + self.y * self.y


class Rect:
    def __init__(self, int x=0, int y=0, int width=0, int height=0):
        self.x = x
        self.y = y
        self.width = width
        self.height = height

    def move_ip(self, int dx, int dy):
        self.x += dx
        self.y += dy

    def collidepoint(self, int x, int y) -> bool:
        return self.x <= x < self.x + self.width and self.y <= y < self.y + self.height
