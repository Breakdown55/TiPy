# A toolkit loop: input, movement, drawing and presentation stay explicit.
import egx
from geometry import Vector2, Rect
from timing import Clock

egx.init()
position = Vector2(42, 28)
box = Rect(0, 0, 8, 8)
clock = Clock()

while not egx.key_down("clear"):
    int dt = clock.tick(60)
    int dx = int(egx.key_down("right")) - int(egx.key_down("left"))
    int dy = int(egx.key_down("down")) - int(egx.key_down("up"))
    position.move_ip(dx, dy)

    egx.clear()
    egx.draw_rect(position.x, position.y, box.width, box.height)
    egx.draw_text("ARROWS: MOVE", 1, 1)
    egx.flip()

egx.quit()
