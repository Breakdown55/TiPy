# Open this file and lumen_gallery.obj together, then Compile and Run.
# Arrows: walk/turn. Hold 2nd + left/right to strafe. CLEAR exits.
# Find the crystal in the east room, then return to the west entrance.
set_render_quality("aggressive")

int gallery = load_scene(
    "lumen_gallery.obj", background="room", floor_y=-8,
    brightness={"doorway": 14, "panel": 5, "crystal": 2},
    unlit=["panel", "crystal"]
)
int player = first_person(x=-18, z=10, yaw=45)
int sun = orbit_light(radius=24, height=24, period=16)

bool collected = False
bool won = False

while not key_down("clear"):
    if not won:
        update_player(player, gallery)
        if not collected and player_near(player, 14, -8):
            collected = True
            set_visible(gallery, "crystal", False)
        if collected and player_near(player, -18, 10):
            won = True

    clear()
    if won:
        print("YOU WIN", 27, 24)
        print("CLEAR: EXIT", 15, 39)
    else:
        draw_scene(gallery, camera=player, light=sun)
        clear_rect(0, 0, 96, 9)
        if collected:
            print("RETURN WEST", 1, 1)
        else:
            print("FIND CRYSTAL", 1, 1)
    render()
