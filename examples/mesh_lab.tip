# Optimized indexed wireframes. No heap or per-frame list construction.
# Arrows: rotate. 2nd/Control: next model. Enter: toggle automatic spin.
# Plus/minus: scale. Clear/Escape: quit. Click the LCD for keyboard input.
# mesh(vertices, edges) packs constant data at compile time.
# draw_mesh(model, x=0,y=0,z=0, yaw=0,pitch=0,roll=0, size=256)
# Angles: 256 steps per turn. Size: 256=1x, 512=2x.
# Mesh vertices: |x|+|y|+|z| <= 60; up to 64 vertices / 192 edges.
# Camera-relative instance centers: |x|+|y|+|z| <= 120.
# Instances outside the bounded range are skipped. In-range edges are clipped.
# Mesh camera: +Y up, FOV 55..120, clipping 1 <= near < far <= 127.
# Rendered wireframes are transparent; this path has no depth buffer.
import time

int cube=mesh([
    (-12,-12,-12),(12,-12,-12),(12,12,-12),(-12,12,-12),
    (-12,-12,12),(12,-12,12),(12,12,12),(-12,12,12)
],[(0,1),(1,2),(2,3),(3,0),(4,5),(5,6),(6,7),(7,4),(0,4),(1,5),(2,6),(3,7)])

int ship=mesh([
    (0,0,-24),(-18,0,12),(18,0,12),(0,8,6),(0,-5,8),(0,0,16)
],[(0,1),(0,2),(0,3),(0,4),(1,3),(2,3),(1,4),(2,4),(1,5),(2,5),(3,5),(4,5)])

int crystal=mesh([
    (0,22,0),(0,-22,0),(-12,0,0),(12,0,0),(0,0,-12),(0,0,12)
],[(0,2),(0,3),(0,4),(0,5),(1,2),(1,3),(1,4),(1,5),(2,4),(4,3),(3,5),(5,2)])

set_cpu_speed(15)
init_camera(fov=75,near=2,far=120)
camera(0,0,48,0,0,0)
int selected=0
int yaw=24
int pitch=16
int size=320
int previous=time.frame_ticks()
int motion=0
bool automatic=True
bool enter_was=False
bool next_was=False
bool dirty=True

while not key_down("clear"):
    int now=time.frame_ticks()
    int elapsed=min(16,(now-previous)&255)
    previous=now
    bool enter=key_down("enter")
    bool next=key_down("2nd")
    if enter and not enter_was:
        automatic=not automatic
        dirty=True
    if next and not next_was:
        selected=(selected+1)%3
        dirty=True
    enter_was=enter
    next_was=next
    int turn=int(key_down("right"))-int(key_down("left"))
    int tilt=int(key_down("up"))-int(key_down("down"))
    int zoom=int(key_down("+"))-int(key_down("-"))
    motion+=elapsed
    if motion>=4:
        int steps=motion//4
        motion%=4
        if turn!=0 or tilt!=0 or zoom!=0 or automatic:
            yaw=(yaw+(turn*2+int(automatic and turn==0))*steps)&255
            pitch=(pitch+tilt*steps*2)&255
            size=max(128,min(512,size+zoom*steps*8))
            dirty=True
    if not dirty:
        time.sleep(0.004)
        continue
    clear()
    if selected==0:
        draw_mesh(cube,yaw=yaw,pitch=pitch,size=size)
        print("CUBE",36,1)
    elif selected==1:
        draw_mesh(ship,yaw=yaw,pitch=pitch,size=size)
        print("SHIP",36,1)
    else:
        draw_mesh(crystal,yaw=yaw,pitch=pitch,size=size)
        print("CRYSTAL",27,1)
    if automatic:
        print("SPIN",1,56)
    else:
        print("HOLD",1,56)
    print("2ND:NEXT",47,56)
    render()
    dirty=False

time.stop_frame_timer()
set_cpu_speed(6)
