# ION DASH 3D -- collect 12 cells, dodge the drones, keep your signal alive.
# Arrows: move. 2nd / Control: dash (briefly invulnerable).
# Enter: start / pause / retry. Clear / Escape: quit.
import time

set_cpu_speed(15)

# Arrows move along the floor: Up goes away from the camera.
# Q4 positions keep slow and diagonal movement smooth without floats.
int enemy_x=[240,1296,1296,240,768,768]
int enemy_y=[272,736,272,736,224,784]
int enemy_vx=[12,-12,-10,10,14,-14]
int enemy_vy=[9,-9,11,-11,8,-8]
int start_x=[240,1296,1296,240,768,768]
int start_y=[272,736,272,736,224,784]
int start_vx=[12,-12,-10,10,14,-14]
int start_vy=[9,-9,11,-11,8,-8]
int cell_x=[68,24,80,17,48,84,12,62,32,76,20,48]
int cell_y=[31,18,44,44,17,20,30,46,31,15,26,31]
def heart(int x):
    h_line(x+1,2,x+2,2)
    h_line(x+4,2,x+5,2)
    h_line(x,3,x+6,3)
    h_line(x+1,4,x+5,4)
    h_line(x+2,5,x+4,5)
    pixel_on(x+3,6)

def diamond(int x,int y,int radius):
    line(x,y-radius,x+radius,y)
    line(x+radius,y,x,y+radius)
    line(x,y+radius,x-radius,y)
    line(x-radius,y,x,y-radius)

# Small fixed perspective camera, looking down at the XZ playfield.
# Its basis is a 3-4-5 triangle: right=X, up=(0,4,-3)/5.
# All coordinates stay bounded, so these i16 products cannot overflow.
# Focal length is 70 LCD pixels; the arena center is 100 units away.
def project_x(int x,int y,int z) -> int:
    int depth=100-(4*z+3*y)//5
    return 48+x*70//depth

def project_y(int y,int z) -> int:
    int depth=100-(4*z+3*y)//5
    return 32-((4*y-3*z)*14)//depth

def edge3d(int ax,int ay,int az,int bx,int by,int bz):
    line(project_x(ax,ay,az),project_y(ay,az),project_x(bx,by,bz),project_y(by,bz))

def actor(int x,int z,int height,bool solid):
    int wx=(x>>4)-48
    int wz=(31-(z>>4))*2
    # Project each shared vertex once, then connect the indexed edges.
    int x0=project_x(wx-3,0,wz-3)
    int y0=project_y(0,wz-3)
    int x1=project_x(wx+3,0,wz-3)
    int x2=project_x(wx+3,0,wz+3)
    int y2=project_y(0,wz+3)
    int x3=project_x(wx-3,0,wz+3)
    int tx=project_x(wx,height,wz)
    int ty=project_y(height,wz)
    line(x0,y0,x1,y0)
    line(x1,y0,x2,y2)
    line(x2,y2,x3,y2)
    line(x3,y2,x0,y0)
    line(x0,y0,tx,ty)
    line(x1,y0,tx,ty)
    line(x2,y2,tx,ty)
    line(x3,y2,tx,ty)
    if solid:
        h_line(tx-1,ty,tx+1,ty)

def arena(int score,int lives,int cooldown,bool paused):
    # A floor grid and short corner posts establish depth and scale.
    edge3d(-44,0,-36,44,0,-36)
    edge3d(44,0,-36,44,0,34)
    edge3d(44,0,34,-44,0,34)
    edge3d(-44,0,34,-44,0,-36)
    edge3d(-22,0,-36,-22,0,34)
    edge3d(0,0,-36,0,0,34)
    edge3d(22,0,-36,22,0,34)
    edge3d(-44,0,-12,44,0,-12)
    edge3d(-44,0,12,44,0,12)
    edge3d(-44,0,-36,-44,12,-36)
    edge3d(44,0,-36,44,12,-36)
    edge3d(-44,0,34,-44,12,34)
    edge3d(44,0,34,44,12,34)
    # HUD coordinates bypass the perspective camera.
    print("E",2,1)
    print(score,10,1)
    print("/12",25,1)
    for i in range(lives):
        heart(66+i*9)
    if paused:
        print("PAUSED / ENTER",5,56)
    else:
        print("2ND",3,56)
        h_line(27,56,64,56)
        h_line(27,62,64,62)
        v_line(27,56,27,62)
        v_line(64,56,64,62)
        int charge=(128-cooldown)>>2
        if charge>0:
            for row in range(58,61):
                h_line(29,row,28+charge,row)

int player_x=768
int player_y=496
int facing_x=1
int facing_y=0
int score=0
int lives=3
int dash_cooldown=0
int dash_left=0
int invulnerable=0
int mode=0
int animation=0
int physics=0
int previous=time.frame_ticks()
bool enter_was=False
bool dash_was=False
bool dirty=True

while not key_down("clear"):
    int now=time.frame_ticks()
    int elapsed=min(16,(now-previous)&255)
    previous=now
    bool enter=key_down("enter")
    bool dash=key_down("2nd")
    bool enter_pressed=enter and not enter_was
    bool dash_pressed=dash and not dash_was
    enter_was=enter
    dash_was=dash

    if mode==0 or mode==2 or mode==4:
        if enter_pressed:
            player_x=768
            player_y=496
            facing_x=1
            facing_y=0
            score=0
            lives=3
            dash_cooldown=0
            dash_left=0
            invulnerable=48
            physics=0
            animation=0
            for i in range(6):
                enemy_x[i]=start_x[i]
                enemy_y[i]=start_y[i]
                enemy_vx[i]=start_vx[i]
                enemy_vy[i]=start_vy[i]
            mode=1
            dirty=True
    elif enter_pressed:
        mode=3 if mode==1 else 1
        physics=0
        dirty=True

    if mode==1:
        animation=(animation+elapsed)&255
        dash_cooldown=max(0,dash_cooldown-elapsed)
        dash_left=max(0,dash_left-elapsed)
        invulnerable=max(0,invulnerable-elapsed)
        int dx=int(key_down("right"))-int(key_down("left"))
        int dy=int(key_down("up"))-int(key_down("down"))
        if dx!=0 or dy!=0:
            facing_x=dx
            facing_y=dy
        if dash_pressed and dash_cooldown==0:
            dash_left=16
            dash_cooldown=128
            dirty=True

        physics+=elapsed
        while physics>=4 and mode==1:
            physics-=4
            int move=11 if dx!=0 and dy!=0 else 16
            if dash_left>0:
                move=11 if facing_x!=0 and facing_y!=0 else 16
                player_x+=facing_x*move*4
                player_y+=facing_y*move*4
            else:
                player_x+=dx*move
                player_y+=dy*move
            player_x=max(64,min(1456,player_x))
            player_y=max(224,min(784,player_y))

            int active=min(6,2+score//2)
            for i in range(active):
                # Later rounds add a slower drone that follows the player.
                if score>=4 and i==active-1:
                    enemy_vx[i]=8 if enemy_x[i]<player_x else -8
                    enemy_vy[i]=8 if enemy_y[i]<player_y else -8
                int next_x=enemy_x[i]+enemy_vx[i]
                int next_y=enemy_y[i]+enemy_vy[i]
                if next_x<80 or next_x>1440:
                    enemy_vx[i]=-enemy_vx[i]
                    next_x=max(80,min(1440,next_x))
                if next_y<224 or next_y>784:
                    enemy_vy[i]=-enemy_vy[i]
                    next_y=max(224,min(784,next_y))
                enemy_x[i]=next_x
                enemy_y[i]=next_y
                if invulnerable==0 and dash_left==0:
                    if abs(next_x-player_x)<64 and abs(next_y-player_y)<64:
                        lives-=1
                        invulnerable=80
                        if lives==0:
                            mode=2

            if mode==1 and abs((cell_x[score]<<4)-player_x)<=64 and abs((cell_y[score]<<4)-player_y)<=64:
                score+=1
                invulnerable=max(invulnerable,16)
                if score==4 or score==8:
                    lives=min(3,lives+1)
                if score==12:
                    mode=4

            dirty=True

    if not dirty:
        time.sleep(0.004)
        continue

    clear()
    if mode==1 or mode==3:
        arena(score,lives,dash_cooldown,mode==3)
        actor(cell_x[score]<<4,cell_y[score]<<4,16,False)
        for i in range(min(6,2+score//2)):
            actor(enemy_x[i],enemy_y[i],4,False)
        if dash_left>0:
            actor(max(64,min(1456,player_x-facing_x*80)),max(224,min(784,player_y-facing_y*80)),3,False)
        if invulnerable==0 or mode==3 or (animation>>3)&1==0:
            actor(player_x,player_y,10,True)
        if mode==1:
            print("II",80,56)
    else:
        h_line(0,0,95,0)
        h_line(0,63,95,63)
        v_line(0,0,0,63)
        v_line(95,0,95,63)
        if mode==0:
            diamond(48,7,3)
            print("ION DASH 3D",15,14)
            print("12 CELLS / 3 HP",6,27)
            print("ARROWS MOVE",15,37)
            print("CTRL/2ND DASH",12,46)
            print("ENTER TO START",6,56)
        elif mode==4:
            print("CIRCUIT CLEAR",9,16)
            print("SIGNAL STABLE",9,29)
            print("ENTER / AGAIN",9,45)
            print("ESC / EXIT",18,56)
        else:
            print("SIGNAL LOST",15,16)
            print("CELLS",21,29)
            print(score,60,29)
            print("ENTER / RETRY",9,45)
            print("ESC / EXIT",18,56)
    render()
    dirty=False

time.stop_frame_timer()
set_cpu_speed(6)
