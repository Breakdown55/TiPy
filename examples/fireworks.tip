import time
import random

W = 96
H = 64

def draw_circle(cx, cy, radius):
    for y in range(-radius, radius + 1):
        for x in range(-radius, radius + 1):
            if x*x + y*y <= radius*radius:
                px = cx + x
                py = cy + y
                if 0 <= px < W and 0 <= py < H:
                    pixel_on(px, py)

def firework(cx, cy):
    clear()
    for radius in range(1, 23, 2):
        for angle in range(0, 360, 8):
            import math
            a = math.radians(angle)
            x = int(cx + math.cos(a) * radius)
            y = int(cy + math.sin(a) * radius)
            if 0 <= x < W and 0 <= y < H:
                pixel_on(x, y)
        render()
        time.sleep(0.04)
        for _ in range(20):
            x = random.randint(max(0, cx-24), min(W-1, cx+24))
            y = random.randint(max(0, cy-24), min(H-1, cy+24))
            flip_pixel(x, y)
        render()
        time.sleep(0.08)
    time.sleep(0.3)

while True:
    x = random.randint(15, 80)
    y = random.randint(15, 45)
    firework(x, y)
    clear()
    render()
    time.sleep(0.2)
