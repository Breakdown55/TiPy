# Easy GX is complete on its own. GX adds explicit rendering control.
# Both use one camera and model matrix; rotation angles are radians.
# scale(factor) is uniform and positive. The stack holds 8 saved transforms.
import egx
import gx

egx.init()
egx.init_camera(fov=75, near=2, far=90)
egx.camera(0, 0, 24, 0, 0, 0)

int panel = egx.mesh(
    [(-4,-4,-4), (4,-4,-4), (4,4,-4), (-4,4,-4),
     (-4,-4,4), (4,-4,4), (4,4,4), (-4,4,4)],
    edges=[(0,1),(1,2),(2,3),(3,0),(4,5),(5,6),(6,7),(7,4),
           (0,4),(1,5),(2,6),(3,7)]
)

egx.clear()
gx.push_matrix()
egx.translate(-4, 0, 0)
egx.rotate_y(0.5)
egx.scale(1.25)
egx.draw_mesh(panel, filled=False)
egx.pop_matrix()

egx.push_matrix()
egx.translate(70, 30)
egx.rotate(0.3)
egx.draw_rect(-8, -5, 16, 10, filled=False)
gx.pop_matrix()

# Text and raw framebuffer access use screen coordinates.
egx.draw_text("GX + EASY GX", 0, 54)
egx.render()
egx.quit()
