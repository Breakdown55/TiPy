# Hold LEFT/RIGHT to turn, UP/DOWN to look up/down. CLEAR (Escape) exits.
# Click the calculator screen before using your keyboard.
# 256 headings; movement follows the 128 Hz crystal timer (wrap: 2 seconds).
# Built entirely with existing XYZ lines; XY pixels form the crosshair.
import time

set_cpu_speed(15)
no_fill()
init_camera(fov=75, near=2, far=300)
int yaw=0
int pitch=0
int dx=[0,25,50,75,100,125,150,175,200,224,249,273,297,321,345,369,392,415,438,460,483,505,526,548,569,590,610,630,650,669,688,706,724,742,759,775,792,807,822,837,851,865,878,891,903,915,926,936,946,955,964,972,980,987,993,999,1004,1009,1013,1016,1019,1021,1023,1024,1024,1024,1023,1021,1019,1016,1013,1009,1004,999,993,987,980,972,964,955,946,936,926,915,903,891,878,865,851,837,822,807,792,775,759,742,724,706,688,669,650,630,610,590,569,548,526,505,483,460,438,415,392,369,345,321,297,273,249,224,200,175,150,125,100,75,50,25,0,-25,-50,-75,-100,-125,-150,-175,-200,-224,-249,-273,-297,-321,-345,-369,-392,-415,-438,-460,-483,-505,-526,-548,-569,-590,-610,-630,-650,-669,-688,-706,-724,-742,-759,-775,-792,-807,-822,-837,-851,-865,-878,-891,-903,-915,-926,-936,-946,-955,-964,-972,-980,-987,-993,-999,-1004,-1009,-1013,-1016,-1019,-1021,-1023,-1024,-1024,-1024,-1023,-1021,-1019,-1016,-1013,-1009,-1004,-999,-993,-987,-980,-972,-964,-955,-946,-936,-926,-915,-903,-891,-878,-865,-851,-837,-822,-807,-792,-775,-759,-742,-724,-706,-688,-669,-650,-630,-610,-590,-569,-548,-526,-505,-483,-460,-438,-415,-392,-369,-345,-321,-297,-273,-249,-224,-200,-175,-150,-125,-100,-75,-50,-25]
int dz=[-1024,-1024,-1023,-1021,-1019,-1016,-1013,-1009,-1004,-999,-993,-987,-980,-972,-964,-955,-946,-936,-926,-915,-903,-891,-878,-865,-851,-837,-822,-807,-792,-775,-759,-742,-724,-706,-688,-669,-650,-630,-610,-590,-569,-548,-526,-505,-483,-460,-438,-415,-392,-369,-345,-321,-297,-273,-249,-224,-200,-175,-150,-125,-100,-75,-50,-25,0,25,50,75,100,125,150,175,200,224,249,273,297,321,345,369,392,415,438,460,483,505,526,548,569,590,610,630,650,669,688,706,724,742,759,775,792,807,822,837,851,865,878,891,903,915,926,936,946,955,964,972,980,987,993,999,1004,1009,1013,1016,1019,1021,1023,1024,1024,1024,1023,1021,1019,1016,1013,1009,1004,999,993,987,980,972,964,955,946,936,926,915,903,891,878,865,851,837,822,807,792,775,759,742,724,706,688,669,650,630,610,590,569,548,526,505,483,460,438,415,392,369,345,321,297,273,249,224,200,175,150,125,100,75,50,25,0,-25,-50,-75,-100,-125,-150,-175,-200,-224,-249,-273,-297,-321,-345,-369,-392,-415,-438,-460,-483,-505,-526,-548,-569,-590,-610,-630,-650,-669,-688,-706,-724,-742,-759,-775,-792,-807,-822,-837,-851,-865,-878,-891,-903,-915,-926,-936,-946,-955,-964,-972,-980,-987,-993,-999,-1004,-1009,-1013,-1016,-1019,-1021,-1023,-1024]
int last_yaw=-1
int last_pitch=-1000

int previous_tick=time.frame_ticks()
int motion=0
bool was_moving=False

while not key_down("clear"):
    int now=time.frame_ticks()
    int elapsed=(now-previous_tick)%256
    previous_tick=now
    int turn=int(key_down("right"))-int(key_down("left"))
    int tilt=int(key_down("up"))-int(key_down("down"))
    bool moving=turn!=0 or tilt!=0
    if moving:
        motion=min(motion+elapsed,32)
        if not was_moving:
            motion=2
        int steps=motion//2
        motion%=2
        yaw=(yaw+turn*steps)%256
        pitch=max(-700,min(700,pitch+tilt*steps*10))
    else:
        motion=0
    was_moving=moving

    if yaw!=last_yaw or pitch!=last_pitch:
        camera(0,0,0,dx[yaw],pitch,dz[yaw])
        clear()

        # Floor and ceiling edges of a 120 x 60 x 160 room.
        line(-60,-30,-80,60,-30,-80)
        line(60,-30,-80,60,-30,80)
        line(60,-30,80,-60,-30,80)
        line(-60,-30,80,-60,-30,-80)
        line(-60,30,-80,60,30,-80)
        line(60,30,-80,60,30,80)
        line(60,30,80,-60,30,80)
        line(-60,30,80,-60,30,-80)
        line(-60,-30,-80,-60,30,-80)
        line(60,-30,-80,60,30,-80)
        line(60,-30,80,60,30,80)
        line(-60,-30,80,-60,30,80)

        # Door outline on the front wall, window on the right wall.
        line(-12,-30,-80,-12,12,-80)
        line(-12,12,-80,12,12,-80)
        line(12,12,-80,12,-30,-80)
        line(60,-5,-25,60,15,-25)
        line(60,15,-25,60,15,15)
        line(60,15,15,60,-5,15)
        line(60,-5,15,60,-5,-25)

        pixel_on(47,32)
        pixel_on(48,32)
        pixel_on(49,32)
        pixel_on(48,31)
        pixel_on(48,33)
        render()
        last_yaw=yaw
        last_pitch=pitch
    else:
        time.sleep(0.005)

time.stop_frame_timer()
set_cpu_speed(6)
